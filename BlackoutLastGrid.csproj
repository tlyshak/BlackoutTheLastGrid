<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>BlackoutLastGrid</RootNamespace>
    <AssemblyName>BlackoutLastGrid</AssemblyName>
    <!-- Local Godot editor binaries live inside the repo; never compile/copy anything from there. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);GodotEngine/**;.godot/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Smoke-test support scripts (tests/smoke/support) are only needed by the editor and the
       headless smoke runs, which load the Debug build; keep them out of export builds. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="tests/**" />
  </ItemGroup>
</Project>
