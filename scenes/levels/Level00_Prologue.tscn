[node name="Level00_Prologue" type="Node2D" node_paths=PackedStringArray("Player", "Camera", "Pause", "StartRoom", "DebugLabel", "Hud", "Cutscene", "Darkness", "Tutorial", "DanFigure", "Door1", "Door2", "FlashlightPrompt", "FanPanel", "AlarmLights", "GuardSpawner", "Exit")]
y_sort_enabled = true
script = ExtResource("1_level")
IntroLines = PackedStringArray("Шахта-звалище «Зміна». Кінець зміни. Рей і Дан розбирають старі акумулятори для заводу банди.", "Дан: — Ще пару таких змін — і дадуть подвійну норму. Якщо працювати, дадуть більше, Рею.", "Рей: — Побачимо. Я нагору, до вентиляційної. Не засиджуйся внизу.")
NoPowerLines = PackedStringArray("Немає живлення. Панель обезструмлена згори.", "З диспетчерської: «Нижні не платять — нижнім не світимо». Вентиляцію нижніх горизонтів вимкнено.")
DanLines = PackedStringArray("Дан лишився внизу. Спуск уже перекрито — Рей не встигає його витягнути.", "Згори чутно кроки: охорона зачищає горизонт. Треба вибиратися.")
ForemanLines = PackedStringArray("Бригадир: — Дан… Записую: втрата по недбалості. Штраф зміні.", "Енергію зміни урізано. Це все, що бригадир має сказати про Дана.")
EndLines = PackedStringArray("Рей повертається в район. У вікні майстерні — мертва районна електростанція.", "Якби район мав своє світло — банда не мала б важеля.", "Рішення: запустити її.")
NextLevel = ExtResource("14_next")
