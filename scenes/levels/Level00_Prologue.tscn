[node name="Level00_Prologue" type="Node2D" node_paths=PackedStringArray("Player", "Camera", "Pause", "Hud", "Companion", "Checkpoints", "StartRoom", "SurfaceRoom", "Circuit", "Lights", "Pump", "Extractor", "Floodlight", "Cage", "GasPockets", "Crew", "BlastCollapse", "UpperCollapse", "FinalCollapse", "TimberPile", "FirstOutlet", "WorkLamps", "BlastSparks", "BlastSparkLight", "GuardSpawner", "FarewellCheckpoint", "SurfaceCheckpoint", "Cutscene", "Darkness", "Tutorial", "MovePrompt", "JumpPrompt", "FlashlightPrompt", "DebugLabel")]
y_sort_enabled = true
script = ExtResource("1_level")
IntroLines = PackedStringArray("Lower horizon. Fourth hour of the shift. The lamps hold. The air does not move.", "DAN: Sixty carts today. Sixty. Two weeks over quota now, and they count it, Ray. They have to count it.", "DAN: You work, they give you more. That's the whole thing. That's all it is.", "RAY: Sure.", "Ray taps the methane head on the rib with two fingers. The needle does not move. It has not moved in eight days.", "DAN: You wrote them about that one. Week back. They wrote you back, yeah?", "RAY: They wrote back.")
BlastLines = PackedStringArray("A spark off the conveyor motor. The air takes it.", "The horizon folds. The lamp string goes out from the far end, one bulb at a time.")
FarewellLines = PackedStringArray("The roof comes down between them and the cage. When the dust drops there is one gap left, at the top, the width of a man's shoulders.", "DAN: Up you go.", "RAY: Both of us. Give me your arm —", "DAN: It's one. You can see it's one.", "Dan gets a shoulder under him and pushes him into the gap. Then he pulls the powerbank off his own belt and presses it into Ray's hand.", "DAN: Take it. Yours is down to eleven. You'll make it.", "RAY: Dan —", "The rest of the roof comes down behind him.")
ForemanLines = PackedStringArray("Lamp room. The shift hands in its tags. The foreman counts them twice and writes one line.", "FOREMAN: Cause of loss: breach of safety procedure by the crew. Fine on the shift. Twenty percent, fourteen days.", "RAY: He was on the bottom horizon because the ventilation was off.", "FOREMAN: Fine's on the shift. That includes his card.", "RAY: He's dead.", "FOREMAN: Card's active to the end of the month. Next.", "Ray asks for the log. Week before last, lower horizon: methane heads, extraction. The page is there. His report is not.")
GuardLines = PackedStringArray("GUARD: Two banks, one card. Hand the other one in.", "Ray does not hand it in. He does not say anything either.", "GUARD: Have it your way.")
EndLines = PackedStringArray("Morning. The wind off the spoil tip is cold and full of coal.", "Behind him the district plant stands with its stacks cold. This coal fed that plant.", "The street lamps are dead the whole way down the hill. They have been for years.", "On the horizon the centre is lit. All of it. Every floor.", "Ray's own bank reads eleven percent. Dan's is full.", "He puts Dan's in the inside pocket, where it does not touch anything.", "Then he starts walking down the hill.")
NextLevel = ExtResource("12_next")
