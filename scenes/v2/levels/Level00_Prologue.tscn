[node name="Level00_Prologue" type="Node2D" node_paths=PackedStringArray("Player", "Camera", "Pause", "Hud", "Companion", "Checkpoints", "StartRoom", "SurfaceRoom", "Circuit", "Director", "Lights", "Cage", "Charge", "Jam", "JamDecal", "BlastCollapse", "BlastTrigger", "TimberPile", "GasPockets", "GuardWave", "ArenaZone", "ArenaLamp", "Patrol", "PatrolPools", "Outlets", "DanRoute", "HeldGuards", "SurfaceCheckpoint", "LevelExit", "WorkLamps", "BlastSparks", "BlastSparkLight", "ConveyorAnimation", "Cutscene", "Darkness", "Tutorial", "MovePrompt", "JumpPrompt", "FlashlightPrompt", "AttackPrompt", "HeavyPrompt", "DebugLabel")]
y_sort_enabled = true
script = ExtResource("1_level")
IntroLines = PackedStringArray("Lower horizon. Last hour of the shift. The belt is running and the lamps hold.", "DAN: The sealed drift, past the old return. I went down it. The bars are new, Ray. New steel.", "DAN: There's light behind them. Not a lamp. And a cable as thick as my arm. You can hear it.", "DAN: Coal's all there is. That's what they tell us. It isn't.", "DAN: We're not going up with the shift. Not tonight.", "Ray does not ask what the light was. He is looking at the belt motor.", "RAY: I know how it breaks.")
ChargeLines = PackedStringArray("Two minutes with the motor open. He does not hurry. The belt keeps running over his hands.", "DAN: That's it? That's all it takes?", "RAY: That's all it ever takes. Walk.")
BlastLines = PackedStringArray("The motor goes when Ray said it would. The roof comes down behind them, across the way back.", "The lamp string dies from the far end, one bulb at a time.")
GuardsLines = PackedStringArray("Two lamps coming down the drift at a run. Miners do not run towards a fall.", "GUARD: Lamps down. Cards out. Against the rib, both of you.")
HeldLines = PackedStringArray("The cage lifts. It climbs at a walking pace, a man's height in ten seconds, and the gate is still open.", "Lamps in the drift behind them. Six, at a run, forty yards off. The one in front carries a rifle.", "Dan looks at the lamps. At the cage. At the lamps. Then he unclips his bank and puts it in Ray's hand.", "DAN: Hold this.", "He turns his own lamp on and walks back down the drift, towards theirs, not fast. The lamps stop on him.", "They take him by the arms. The cage is at head height, then above it. Nobody fires. Nobody follows it.", "DAN: Lamp off, Ray!", "The lamp goes off. What is left is a guard's back, Dan between two of them, and the way down, past the old return.")
EndLines = PackedStringArray("Night, or the end of it. The pit head behind him, and no sound from it.", "Down the hill, the district. No lamps. There have not been lamps there for years.", "On the horizon, the centre. Lit. All of it, every floor, the whole way up.", "Dan's bank in his hand. Full. It is not his. He puts it in the inside pocket, where nothing touches it.", "He starts down the hill.")
NextLevel = ExtResource("12_next")
